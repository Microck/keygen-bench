+// Fixed-duration benchmark capture. Only entry/exit initialize/close the dump;
+// every intervening restart and effect is executed by the unmodified replayer.
+static bool captureModuleToWav(const char *outputPath, const char *budgetText,
+	uint32_t freq, uint8_t bitDepth, int16_t amp, uint8_t startPos,
+	uint32_t *outTotalSamples)
+{
+	char *end;
+	errno = 0;
+	const unsigned long long budget = strtoull(budgetText, &end, 10);
+	const char *tracePath = getenv("KEYGEN_FT2_CAPTURE_TRACE");
+	if (errno || *budgetText == '\0' || *end != '\0' || budget < 1 ||
+		budget > 44100ULL * 900 || tracePath == NULL || *tracePath == '\0' ||
+		freq != 44100 || bitDepth != 16 || amp != 8 || startPos != 0)
+		return false;
+
+	int32_t solo = -1;
+	const char *soloText = getenv("KEYGEN_FT2_CAPTURE_SOLO");
+	if (soloText != NULL)
+	{
+		errno = 0;
+		const long value = strtol(soloText, &end, 10);
+		if (errno || *soloText == '\0' || *end != '\0' ||
+			value < 0 || value >= song.numChannels)
+			return false;
+		solo = (int32_t)value;
+	}
+
+	FILE *f = fopen(outputPath, "wb");
+	if (f == NULL)
+		return false;
+	captureTrace = fopen(tracePath, "wb");
+	if (captureTrace == NULL)
+	{
+		fclose(f);
+		return false;
+	}
+	WDFrequency = freq;
+	WDBitDepth = bitDepth;
+	WDAmp = amp;
+	WDStartPos = 0;
+	pauseAudio();
+	if (fseek(f, sizeof (wavHeader_t), SEEK_SET) != 0 ||
+		!dump_Init(WDFrequency, WDAmp, WDStartPos))
+	{
+		fclose(captureTrace);
+		captureTrace = NULL;
+		fclose(f);
+		resumeAudio();
+		return false;
+	}
+
+	for (int32_t i = 0; i < song.numChannels; i++)
+		channel[i].dontRenderThisChannel = solo >= 0 && i != solo;
+	// A fresh-process canonical export starts from this same dither seed.
+	resetAudioDither();
+	captureFrame = 0;
+	capturePreviousOrder = capturePreviousRow = -1;
+	ft2CaptureCommands = ft2CaptureTransitions = 0;
+	ft2CaptureActive = true;
+	fprintf(captureTrace,
+		"{\"kind\":\"header\",\"schema\":1,\"sample_rate\":44100,"
+		"\"channels\":2,\"module_channels\":%d,\"frame_budget\":%llu,"
+		"\"solo_channel\":%d}\n", song.numChannels, budget, solo);
+
+	bool ok = true;
+	uint64_t tickSamplesFrac = 0;
+	while (captureFrame < budget)
+	{
+		// Deliberately do not call dump_EndOfTune() or consult visited rows.
+		// songLoopStart, Bxx, Dxx, E6x, envelopes and voice tails remain live.
+		dump_TickReplayer();
+		uint32_t tickSamples = audio.samplesPerTickInt;
+		tickSamplesFrac += audio.samplesPerTickFrac;
+		if (tickSamplesFrac >= BPM_FRAC_SCALE)
+		{
+			tickSamplesFrac &= BPM_FRAC_MASK;
+			tickSamples++;
+		}
+		if (tickSamples > budget - captureFrame)
+			tickSamples = (uint32_t)(budget - captureFrame);
+		mixReplayerTickToBuffer(tickSamples, wavRenderBuffer, WDBitDepth);
+		if (fwrite(wavRenderBuffer, sizeof (int16_t) * 2, tickSamples, f) != tickSamples)
+		{
+			ok = false;
+			break;
+		}
+		captureFrame += tickSamples;
+	}
+	ft2CaptureActive = false;
+	fprintf(captureTrace, "{\"kind\":\"end\",\"frames\":%u}\n", captureFrame);
+	ok = !ferror(captureTrace) && ok;
+	if (fclose(captureTrace) != 0)
+		ok = false;
+	captureTrace = NULL;
+	if (fflush(f) != 0)
+		ok = false;
+	dump_Close(f, captureFrame * 2);
+	for (int32_t i = 0; i < song.numChannels; i++)
+		channel[i].dontRenderThisChannel = false;
+	resumeAudio();
+	if (outTotalSamples != NULL)
+		*outTotalSamples = captureFrame * 2;
+	return ok;
+}
