+bool ft2CaptureActive;
+uint8_t ft2CaptureCommands, ft2CaptureTransitions;
+static FILE *captureTrace;
+static uint32_t captureFrame;
+static int16_t capturePreviousOrder, capturePreviousRow;
+
+void ft2CaptureRow(void)
+{
+	// These are latched before effects. Bxx can mutate song.songPos immediately,
+	// and speed 1 can advance song.row before the tick has produced any samples.
+	const int16_t order = song.curReplayerSongPos;
+	const int16_t row = song.curReplayerRow;
+	const uint8_t flags = ft2CaptureTransitions;
+	const char *transition = "row";
+	if (capturePreviousOrder < 0)
+		transition = "start";
+	else if (flags & FT2_CAPTURE_BXX)
+	{
+		const int32_t source = capturePreviousOrder * 256 + capturePreviousRow;
+		const int32_t target = order * 256 + row;
+		transition = target < source ? "bxx_backward" :
+			(target > source ? "bxx_forward" : "bxx_self");
+	}
+	else if (flags & FT2_CAPTURE_RESTART)
+		transition = "natural_restart";
+	else if (flags & FT2_CAPTURE_DXX)
+		transition = "dxx_break";
+	else if (flags & FT2_CAPTURE_E6)
+		transition = "e6_loop";
+	else if (order != capturePreviousOrder)
+		transition = "next_order";
+
+	fprintf(captureTrace,
+		"{\"kind\":\"row\",\"frame\":%u,\"order\":%d,\"row\":%d,"
+		"\"pattern\":%u,\"speed\":%u,\"bpm\":%u,\"transition\":\"%s\","
+		"\"from_order\":%d,\"from_row\":%d,\"to_order\":%d,\"to_row\":%d,"
+		"\"bxx\":%s,\"dxx\":%s,\"e6\":%s,\"natural_restart\":%s,",
+		captureFrame, order, row, song.curReplayerPattNum, song.speed, song.BPM,
+		transition, capturePreviousOrder, capturePreviousRow, order, row,
+		(flags & FT2_CAPTURE_BXX) ? "true" : "false",
+		(flags & FT2_CAPTURE_DXX) ? "true" : "false",
+		(flags & FT2_CAPTURE_E6) ? "true" : "false",
+		(flags & FT2_CAPTURE_RESTART) ? "true" : "false");
+	// Sequencer state distinguishes finite E6 repetitions from an endless cycle.
+	// Voice phase is deliberately excluded: it does not control future row flow.
+	fprintf(captureTrace, "\"control_state\":[%d,%d,%d,%d,%d,%d,%d,%d,%d,%d",
+		order, row, song.songPos, song.speed, song.BPM, song.pattDelTime,
+		song.pattDelTime2, song.pBreakPos, song.pBreakFlag, song.posJumpFlag);
+	for (int32_t i = 0; i < song.numChannels; i++)
+		fprintf(captureTrace, ",%d,%d", channel[i].patternLoopStartRow,
+			channel[i].patternLoopCounter);
+	fputs("]}\n", captureTrace);
+	capturePreviousOrder = order;
+	capturePreviousRow = row;
+	ft2CaptureTransitions = 0;
+}
