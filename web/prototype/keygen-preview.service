[Unit]
Description=Keygen public results snapshot
After=network.target

[Service]
Type=simple
User=ubuntu
ExecStart=/usr/bin/python3 /home/ubuntu/keygen-web-tools-20261001/serve.py --root /home/ubuntu/keygen-public-20261002-v5 --port 8780 --bind 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=/home/ubuntu/keygen-full.eALj54bh /home/ubuntu/.ssh /home/ubuntu/.config
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
